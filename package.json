{
	"$schema": "https://www.schemastore.org/package",
	"name": "@dariah-eric/dariah-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"imports": {
		"#/*": "./*"
	},
	"scripts": {
		"analyze": "bun run --bun next analyze",
		"build": "bun run --bun next build",
		"dev": "bun run --bun next dev",
		"dev:env:init": "sh ./scripts/dev/env.sh",
		"dev:services:down": "sh ./scripts/dev/services.sh stop",
		"dev:services:setup": "sh ./scripts/dev/setup.sh",
		"dev:services:up": "sh ./scripts/dev/services.sh start",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"generate:countries": "sh ./scripts/geo/generate.sh",
		"generate:openapi": "bun ./scripts/openapi/generate.ts",
		"generate:pages": "bun ./scripts/pages/generate.ts",
		"lint:check": "FORCE_COLOR=1 bun run --parallel lint:code:check lint:styles:check",
		"lint:code:check": "oxlint --report-unused-disable-directives --type-aware --type-check",
		"lint:code:fix": "oxlint --fix --report-unused-disable-directives --type-aware --type-check",
		"lint:fix": "FORCE_COLOR=1 bun run --parallel lint:code:fix lint:styles:fix",
		"lint:i18n:check": "eloqnt lint",
		"lint:styles:check": "stylelint \"./**/*.css\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "stylelint \"./**/*.css\" --cache --fix --ignore-path ./.gitignore",
		"prepare": "(is-in-ci || bun run dev:env:init) && bun run --sequential types:prepare generate:openapi generate:pages",
		"search:api-keys:generate": "bun ./scripts/search/generate-search-api-keys.ts",
		"search:collections:create": "bun ./scripts/search/create-collections.ts",
		"search:collections:reset": "bun ./scripts/search/reset-collections.ts",
		"search:fixtures:load": "bun ./scripts/search/load-fixtures.ts",
		"start": "bun run --bun next start",
		"storybook:build": "storybook build",
		"storybook:dev": "storybook dev --no-open --port 6006",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts --update-snapshots=missing",
		"test:types": "tsc --project ./tests/types/tsconfig.json",
		"test:unit": "bun test ./tests/unit",
		"types:check": "tsc --noEmit",
		"types:prepare": "ENV_VALIDATION=\"none\" bun run --bun next typegen"
	},
	"dependencies": {
		"@acdh-oeaw/lib": "^1.0.7",
		"@internationalized/date": "^3.12.4",
		"@sindresorhus/slugify": "^3.0.1",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-heading": "^3.31.4",
		"@tiptap/extension-table": "^3.31.4",
		"@tiptap/starter-kit": "^3.31.4",
		"@tiptap/static-renderer": "^3.31.4",
		"@valibot/i18n": "^1.3.0",
		"better-result": "^3.0.1",
		"client-only": "^0.0.1",
		"clsx": "^2.1.1",
		"leaflet": "^2.0.0-alpha.1",
		"lucide-react": "^1.52.0",
		"next": "^16.4.0",
		"next-intl": "^4.14.9",
		"react": "^19.3.0",
		"react-aria": "3.52.1",
		"react-aria-components": "^1.22.0",
		"react-dom": "^19.3.0",
		"react-schemaorg": "^2.0.1",
		"server-only": "^0.0.1",
		"sharp": "^0.35.5",
		"typesense": "^3.1.1",
		"valibot": "^1.5.0",
		"xast-util-feed": "^2.0.0",
		"xast-util-to-xml": "^4.0.0"
	},
	"devDependencies": {
		"@eloqnt/cli": "^0.6.33",
		"@next/env": "^16.4.0",
		"@next/playwright": "^16.4.0",
		"@playwright/cli": "^0.1.21",
		"@playwright/test": "^1.64.0",
		"@react-aria/optimize-locales-plugin": "^2.1.0",
		"@redocly/openapi-core": "2.58.1",
		"@storybook/nextjs-vite": "^10.6.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/turbopack": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"@types/bun": "^1.4.2",
		"@types/geojson": "^7946.0.16",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.14.0",
		"axe-playwright": "^2.2.2",
		"eslint-plugin-better-tailwindcss": "^4.9.0",
		"eslint-plugin-playwright": "^2.12.1",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-storybook": "^10.6.1",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.0",
		"mapshaper": "^0.7.80",
		"oxfmt": "^0.72.0",
		"oxlint": "^1.87.0",
		"oxlint-tsgolint": "^7.0.2003",
		"schema-dts": "^2.1.0",
		"storybook": "^10.6.1",
		"stylelint": "^17.16.0",
		"stylelint-order": "^8.1.1",
		"tailwindcss": "^4.3.3",
		"tailwindcss-react-aria-components": "^2.2.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.3"
	},
	"browserslist": [
		"chrome >= 111",
		"firefox >= 128",
		"safari >= 16.4",
		"ios_saf >= 16.4"
	],
	"stylelint": {
		"extends": "./configs/stylelint/base.json"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^12.10.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "bun",
			"version": "^1.4.2",
			"onFail": "download"
		}
	},
	"engines": {
		"runtime": {
			"name": "bun",
			"version": "^1.4.2",
			"onFail": "download"
		}
	},
	"postcss": {
		"plugins": {
			"@tailwindcss/postcss": {}
		}
	}
}
